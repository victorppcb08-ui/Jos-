\tx1701\wrapdefault\faauto\ls1\rin0\lin1134\itap0\pararsid2177478 \rtlch\fcs1 \af0\afs24\alang1025 \ltrch\fcs0 \fs24\lang1046\langfe1046\cgrid\langnp1046\langfenp1046 {\rtlch\fcs1 \ab\af0\afs22 \ltrch\fcs0 \fs22\insrsid2177478\charrsid2177478 
