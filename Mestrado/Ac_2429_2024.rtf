\fs24\expnd1\expndtw5\cf21\lang1046\langfe1033\kerning28\cgrid\langnp1046\langfenp1033 {\rtlch\fcs1 \ab\ai\af0\afs24 \ltrch\fcs0 \b\i\ul\cf0\insrsid6170124\charrsid15563744 An\'e1lise da Unidade T\'e9cnica
