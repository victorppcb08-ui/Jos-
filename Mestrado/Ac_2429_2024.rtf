\'e7\'f5es de projeto e de tra\'e7ado e de aprova\'e7\'e3o de material
\par {\*\bkmkend _Hlk180486198}{\listtext\pard\plain\ltrpar \s26 \rtlch\fcs1 \ai\af0 \ltrch\fcs0 \expnd1\expndtw5\lang1046\langfe1033\kerning28\langfenp1033\insrsid6170124\charrsid15563744 \hich\af0\dbch\af0\loch\f0 I.4.1.\tab}}\pard \ltrpar
\s26\ql \li567\ri0\sb120\widctlpar\wrapdefault\aspalpha\aspnum\faauto\ls3\ilvl2\outlinelevel2\adjustright\rin0\lin567\itap0\pararsid6170124 {\rtlch\fcs1 \ab\ai\af0\afs24 \ltrch\fcs0 \b\i\ul\cf0\insrsid6170124\charrsid15563744 Manifesta\'e7\'e3
o da Infra S.A. (pe\'e7a 93, p. 37-38)
\par {\listtext\pard\plain\ltrpar \s48 \rtlch\fcs1 \ai\af0 \ltrch\fcs0 \i\lang1046\langfe1033\langfenp1033\insrsid6170124\charrsid15563744 \hich\af0\dbch\af0\loch\f0 138.\tab}}\pard\plain \ltrpar\s48\qj \li567\ri0\sb120\nowidctlpar
